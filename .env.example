# Native launcher settings. Literal KEY=value syntax, optional matching quotes.
# Values are NOT shell-expanded. Paths are relative to the repository root.
SEKSCAN_WORKSPACE=.
SEKSCAN_PORT=8080
# Empty serves portfolio/history. Otherwise serve an existing report directory.
SEKSCAN_REPORT_DIR=
SEKSCAN_PROJECT=
# Start builds automatically when the launcher binary is absent.
SEKSCAN_GO_BIN=go
SEKSCAN_BUILD_TESTS=true
SEKSCAN_START_TIMEOUT=30
SEKSCAN_STOP_TIMEOUT=15
SEKSCAN_LOG_LINES=100
# All application settings can be supplied as compact JSON here (same schema as
# sekscan.json). This is written to .run-settings.json in the workspace on start/cli.
SEKSCAN_SETTINGS_JSON='{}'
# Optional existing config instead of SETTINGS_JSON. Never rewritten by run.sh.
SEKSCAN_CONFIG_FILE=
# Credentials are inherited by the app; do not commit your .env.
SEKSCAN_DB_DSN=
GITHUB_TOKEN=
