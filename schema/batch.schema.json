{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sekscan:batch:v1",
  "title": "sekscan batch manifest v1",
  "description": "One source kind per project. Local paths are relative to the manifest. GitHub project keys default to lowercase owner/repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "continue_on_error": {
      "type": "boolean",
      "default": true
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offline": {
          "type": "boolean"
        },
        "inventory_only": {
          "type": "boolean"
        },
        "gitleaks": {
          "type": "boolean"
        },
        "actionlint": {
          "type": "boolean"
        },
        "trivy_vuln": {
          "type": "boolean"
        },
        "no_store": {
          "type": "boolean"
        },
        "hadolint": {
          "type": "boolean",
          "description": "Enable hadolint when applicable; omitted inherits application defaults."
        },
        "zizmor": {
          "type": "boolean",
          "description": "Enable zizmor when applicable; omitted inherits application defaults."
        },
        "govulncheck": {
          "type": "boolean",
          "description": "Enable govulncheck when applicable; omitted inherits application defaults."
        },
        "gosec": {
          "type": "boolean",
          "description": "Enable gosec when applicable; omitted inherits application defaults."
        },
        "semgrep": {
          "type": "boolean",
          "description": "Deprecated compatibility key. Ignored; Semgrep support was removed in sekscan 0.6.5.",
          "deprecated": true
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "maxLength": 256
        },
        "subdir": {
          "type": "string",
          "maxLength": 1024
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      },
      "oneOf": [
        {
          "required": [
            "project",
            "path"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "repo_url"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "subdir"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "repo_url"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    }
  }
}
